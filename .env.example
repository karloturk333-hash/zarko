# Kopiraj u .env i popuni. .env je u .gitignore — nikad ga ne commitaj.
#
# Ključ generiraj u Trading212: Settings → API
#   → SAMO read dozvole (account data, positions, history)
#   → IP restrikcija na IP Hetzner servera (+ kućni IP za lokalni dev)
#
# Trading212 daje DVA stringa: API key i API secret. Trebaju oba —
# šalju se kao HTTP Basic (key = username, secret = password).
T212_API_KEY=
T212_API_SECRET=

# live | demo — ključ vrijedi samo za okolinu u kojoj je generiran
T212_ENV=live

# Neobavezno: JSON izvor tečajeva u frankfurter formatu.
# Default je ECB XML direktno s ecb.europa.eu.
# FX_API_URL=https://api.frankfurter.dev/v1/latest
